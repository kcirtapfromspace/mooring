        "app/NativeAudio.swift",
        "app/NativePairing.swift",
        "app/NativeTransport.swift",
        "app/NativeSessionState.swift",
        "app/NativeClipboard.swift",
        "app/NativeCursor.swift",
        "app/NativeSessionPorts.swift",
        "app/ConnectionModels.swift",
        "app/LinuxConnectionTypes.swift",
        "scripts/test-native-stream.swift",
        "app/NativeInternetLinks.swift"
      ]
